{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clause": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "heading": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "heading",
        "text"
      ],
      "additionalProperties": false
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "overridden",
              "disputed",
              "edited",
              "accepted"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "quote",
          "explanation",
          "outcome",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "clause",
    "cases"
  ],
  "additionalProperties": false
}
