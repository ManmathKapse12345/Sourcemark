{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fingerprint": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "violation",
              "needs_human_check"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "terminology",
              "fact",
              "claim",
              "tone",
              "style",
              "readability",
              "disclosure",
              "inclusivity"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "origins": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "rule",
                "ai"
              ]
            }
          },
          "span": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "quote": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "rule",
                      "clause",
                      "fact"
                    ]
                  },
                  "code": {
                    "type": "string"
                  },
                  "clause_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "code",
                  "clause_code",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fix": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "replacement": {
                    "type": "string"
                  }
                },
                "required": [
                  "start",
                  "end",
                  "replacement"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "fingerprint",
          "kind",
          "category",
          "severity",
          "origins",
          "span",
          "quote",
          "explanation",
          "source",
          "confidence",
          "fix"
        ],
        "additionalProperties": false
      }
    },
    "rewrites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "original": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "finding_fingerprints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "original",
          "text",
          "finding_fingerprints"
        ],
        "additionalProperties": false
      }
    },
    "ai_status": {
      "type": "string",
      "enum": [
        "ok",
        "disabled",
        "unavailable"
      ]
    },
    "ai_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "stats": {
      "type": "object",
      "properties": {
        "rule_findings": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ai_findings": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ai_downgraded": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ai_dropped_unanchored": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "merged": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "rule_findings",
        "ai_findings",
        "ai_downgraded",
        "ai_dropped_unanchored",
        "merged",
        "duration_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "findings",
    "rewrites",
    "ai_status",
    "ai_error",
    "model",
    "stats"
  ],
  "additionalProperties": false
}
