{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "pdf",
        "docx",
        "txt"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "text",
    "format",
    "warnings"
  ],
  "additionalProperties": false
}
