DATABASE_URL=postgresql://sourcemark:sourcemark@localhost:5434/sourcemark
ANALYSIS_URL=http://localhost:8000
# Must match INTERNAL_TOKEN in services/analysis/.env
ANALYSIS_TOKEN=change-me-to-a-long-random-string

# Local development: tokens minted with `npm run token -- <email>` are signed with this secret.
# With Supabase: set SUPABASE_URL (JWKS signing keys) and/or AUTH_JWT_SECRET (legacy JWT secret).
AUTH_JWT_SECRET=dev-secret-dev-secret-dev-secret-0123456789
# SUPABASE_URL=https://your-project.supabase.co

CORS_ORIGINS=http://localhost:3000
PORT=4000
# How long the API waits for one review (ms). Must exceed ANALYSIS_BUDGET_S + GEMINI_TIMEOUT_S.
ANALYSIS_TIMEOUT_MS=180000
