# Base URL of the Express API (must be listed in the API's CORS_ORIGINS for this site's origin)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Leave empty for local development: the login page then accepts a token from `npm run token`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo mode: one-click sign-in as the seeded Northfern users. Must equal AUTH_JWT_SECRET in apps/api/.env.
# Leave empty in production.
DEMO_AUTH_SECRET=
NEXT_PUBLIC_DEMO_LOGIN=false
