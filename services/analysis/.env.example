# Must match ANALYSIS_TOKEN in apps/api/.env
INTERNAL_TOKEN=change-me-to-a-long-random-string
# Read-only access is enough: the service only reads clause embeddings for retrieval.
DATABASE_URL=postgresql://sourcemark:sourcemark@localhost:5434/sourcemark
# Without a key the service runs rule checks only and reports ai_status "unavailable".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
RETRIEVAL_TOP_K=8
AI_MIN_CONFIDENCE=0.5
